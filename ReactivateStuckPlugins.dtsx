  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Reactivate Stuck Plugins"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EA88BD13-E60F-43AA-A0F6-9D0069813A74}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Reactivate Stuck Plugins"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="{7E69F687-548B-4077-9CC9-C9BDEEA9B7A2}"
          SQLTask:SqlStatementSource="USE ALTSHULER_MSCRM;

-- Reactivate stuck async plugins:
-- take every plugin name that is stuck in StateCode=2 for more than 10 minutes
-- (based on the age of its oldest CreatedOn, in UTC) and reactivate it.
-- If no name passes the 10-minute threshold, nothing is updated.

UPDATE ao
SET ao.StateCode  = 0,
    ao.StatusCode = 10
FROM AsyncOperation ao
INNER JOIN (
    SELECT name
    FROM AsyncOperation WITH (NOLOCK)
    WHERE StateCode = 2
    GROUP BY name
    -- Interpretation = AGE of oldest stuck operation (recommended).
    -- To use the min&lt;-&gt;max SPAN instead, comment the line below and
    -- uncomment the next one.
    HAVING DATEDIFF(MINUTE, MIN(CreatedOn), GETUTCDATE()) &gt; 10
    -- HAVING DATEDIFF(MINUTE, MIN(CreatedOn), MAX(CreatedOn)) &gt; 10
) stuck ON ao.name = stuck.name
WHERE ao.StateCode = 2;" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:DesignTimeProperties><![CDATA[<?xml version="1.0"?>
